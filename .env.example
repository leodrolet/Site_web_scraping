# ============================================================
#  Variables d'environnement — copiez ce fichier en « .env »
# ============================================================

# Clé secrète : signe les sessions utilisateur.
# Génère une vraie valeur aléatoire avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
# puis colle le résultat ci-dessous (sans espaces ni guillemets).
SECRET_KEY=change_moi_avec_une_vraie_valeur_aleatoire

# Base de données (optionnel en local).
# - Si DATABASE_URL est DÉFINIE  -> PostgreSQL (ex. Neon.tech).
# - Si elle est ABSENTE          -> repli automatique sur SQLite (fichier local).
# Format Neon (garde le « -pooler » et sslmode=require) :
#   DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL=

# Cookies « secure » (transmis seulement en HTTPS).
# Laisse vide/false en local (HTTP). En production HTTPS -> COOKIE_SECURE=true.
# NB : sur Vercel, c'est déjà activé automatiquement.
# COOKIE_SECURE=false

# ------------------------------------------------------------
# Clés API du SERVICE (côté serveur uniquement).
# Lues par le serveur via os.getenv() — jamais exposées aux utilisateurs,
# jamais stockées en base, jamais dans le HTML/JS. Renseigne au moins Hunter.io.
# Sur Vercel : ajoute ces variables dans Settings > Environment Variables.
# ------------------------------------------------------------
HUNTER_API_KEY=
APOLLO_API_KEY=
SERPAPI_KEY=

# ------------------------------------------------------------
# Envoi des courriels de confirmation d'adresse (Resend).
# 1. Crée un compte sur https://resend.com
# 2. Vérifie un domaine d'envoi (sinon, en mode bac à sable, tu ne peux
#    envoyer qu'à ta propre adresse via onboarding@resend.dev).
# 3. Génère une clé API et colle-la ci-dessous.
# RESEND_FROM_EMAIL doit utiliser le domaine vérifié (ex. noreply@tondomaine.com).
# Si ces variables sont absentes : la création de compte fonctionne toujours,
# mais aucun courriel n'est envoyé (message d'échec + bouton « Renvoyer »).
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Exiger la confirmation d'email avant l'accès à l'outil.
# DÉSACTIVÉ par défaut (variable absente = false) : sans domaine vérifié chez
# Resend, les vrais utilisateurs ne recevraient pas leur courriel et resteraient
# bloqués. Passe cette variable à « true » UNIQUEMENT une fois ton domaine
# vérifié chez Resend (et RESEND_API_KEY / RESEND_FROM_EMAIL renseignées).
#   EXIGER_CONFIRMATION_EMAIL=true
EXIGER_CONFIRMATION_EMAIL=false
